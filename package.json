{
  "name": "slack-local-mcp",
  "version": "1.5.0",
  "description": "A lightweight MCP server for Slack automation using cookie-based authentication - no app setup required",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "slack-local-mcp": "build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "prepare": "npm run build",
    "test": "node test-slack-mcp.js"
  },
  "keywords": [
    "mcp",
    "slack",
    "model-context-protocol",
    "ai",
    "assistant"
  ],
  "author": "",
  "dependencies": {
